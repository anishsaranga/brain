# ── brain ────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored.

# Neo4j -----------------------------------------------------------------------
# NEO4J_AUTH is read by the neo4j container, and ONLY on the first boot of an
# empty data volume. Changing it later does nothing — the password is already
# baked into the volume — which produces a very confusing "I updated .env and
# now auth fails". To actually rotate it, use `ALTER CURRENT USER SET PASSWORD`
# in cypher-shell, or delete the volume (which deletes the graph).
NEO4J_PASSWORD=change-me-long-random

# What HOST-SIDE SCRIPTS dial (the backup export, import, reembed).
#
# The container does NOT use this: docker-compose.yml sets NEO4J_URI in its
# `environment:` block, which takes precedence over env_file, and there the
# address is the compose service name `brain-neo4j` on the internal network.
# From the host that name does not resolve, so this one is localhost.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# MCP -------------------------------------------------------------------------
# Unguessable path segment. The connector URL becomes
#   https://<HOSTNAME>/mcp/<MCP_PATH_SECRET>
# Generate with:  openssl rand -hex 24
# This is stage-1 auth together with the Cloudflare WAF rule that limits /mcp
# to Anthropic's egress range (160.79.104.0/21). See DEPLOY.md.
MCP_PATH_SECRET=change-me-openssl-rand-hex-24

# The bearer token, carried in a HEADER rather than in the URL. A secret in a
# URL ends up in request logs, browser history and screenshots; a header does
# not. The path secret above stays underneath it as a second factor.
#
# Set it on the connector as EITHER of:
#     Authorization: Bearer <MCP_BEARER_TOKEN>
#     X-Brain-Token: <MCP_BEARER_TOKEN>
# Both are accepted because the claude.ai "Request headers" field is a limited
# beta, and whether it passes a custom Authorization through rather than
# reserving that name for its own OAuth flow is not knowable from this end. If
# one is stripped, switching to the other is a change in a dialog, not a
# redeploy.
#
# Generate with:  openssl rand -hex 32
#
# Three modes, and you want to pass through the middle one on the way:
#   unset                         Path only. The behaviour before this existed.
#   set, MCP_REQUIRE_TOKEN unset  PERMISSIVE. The token is compared and
#                                 reported, but a missing or wrong one still
#                                 passes on the path secret. Nothing you can
#                                 mistype here can break the connector.
#   set, MCP_REQUIRE_TOKEN=1      ENFORCING. No valid token, no entry.
#
# Roll out by setting the token, confirming on /api/health (authenticated)
# that mcpAuth.lastAttempt shows the header arriving and matching, and only
# then setting MCP_REQUIRE_TOKEN=1.
MCP_BEARER_TOKEN=change-me-openssl-rand-hex-32
#MCP_REQUIRE_TOKEN=1

# App -------------------------------------------------------------------------
# Day-boundary logic (what is due today) depends on this. Without it the
# container runs on UTC and "today" rolls over at the wrong moment.
TZ=Asia/Kolkata

# Web UI auth ------------------------------------------------------------------
# Single admin. Gates the explorer and review session; the MCP endpoint has its
# own auth and is exempt from the middleware.
#   AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=change-me-openssl-rand-base64-32
ADMIN_USERNAME=anish
# Either ADMIN_PASSWORD (plaintext) or ADMIN_PASSWORD_HASH (bcrypt, preferred).
# The hash wins when both are set.
ADMIN_PASSWORD=change-me
#ADMIN_PASSWORD_HASH=

# Where this app is reachable, used to build the ingest deep links that
# `remember` hands back to Claude. No trailing slash.
PUBLIC_BASE_URL=http://localhost:9999
