# ── brain ────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored.

# Neo4j -----------------------------------------------------------------------
# NEO4J_AUTH is read by the neo4j container, and ONLY on the first boot of an
# empty data volume. Changing it later does nothing — the password is already
# baked into the volume — which produces a very confusing "I updated .env and
# now auth fails". To actually rotate it, use `ALTER CURRENT USER SET PASSWORD`
# in cypher-shell, or delete the volume (which deletes the graph).
NEO4J_PASSWORD=change-me-long-random

# What the Next app dials. `brain-neo4j` is the compose service name, resolved
# on the internal docker network — not localhost, which inside the web
# container is the web container itself.
NEO4J_URI=bolt://brain-neo4j:7687
NEO4J_USER=neo4j

# MCP -------------------------------------------------------------------------
# Unguessable path segment. The connector URL becomes
#   https://<HOSTNAME>/mcp/<MCP_PATH_SECRET>
# Generate with:  openssl rand -hex 24
# This is stage-1 auth together with the Cloudflare WAF rule that limits /mcp
# to Anthropic's egress range (160.79.104.0/21). See DEPLOY.md.
MCP_PATH_SECRET=change-me-openssl-rand-hex-24

# App -------------------------------------------------------------------------
# Day-boundary logic (what is due today) depends on this. Without it the
# container runs on UTC and "today" rolls over at the wrong moment.
TZ=Asia/Kolkata
